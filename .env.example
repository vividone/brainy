# Brainy — every environment variable, in the order you will need them.
#
# Copy the ones you want into the Vercel project (Settings → Environment
# Variables) and redeploy. Nothing here belongs in the repository: this file is
# the shape of the configuration, not the configuration.
#
# The app works with NONE of these set. Mathematics is free for everybody and
# needs no server at all, usage pings fall back to the function log, and the
# endpoints that genuinely cannot work say so in plain words rather than
# pretending. What each one switches on is noted below.
#
# Check a deployment afterwards with:
#   npm run preflight -- https://brainy.fortbridge.app


# These belong on the RAILWAY service, not on Vercel. Vercel serves the pages and
# proxies /api/* here; after the move it needs only GA_MEASUREMENT_ID, which means
# exactly one place holds the database credentials and the Paystack key.

# ── Database ────────────────────────────────────────────────────────────────
# Everything server-side: sign-ups, licences, coupons, payments, usage.
#
# Now that the API runs inside Railway, use the PRIVATE string — the variable
# Railway itself calls DATABASE_URL, with the host postgres.railway.internal.
# It resolves only inside Railway's network, which is the point: with it, the
# database needs no public networking at all, so switch Public Networking OFF.
#
# (The public DATABASE_PUBLIC_URL is only needed by something hosted elsewhere.
# If you ever see "getaddrinfo ENOTFOUND postgres.railway.internal", whatever
# threw it is not running inside Railway.)
DATABASE_URL=postgres://postgres:password@postgres.railway.internal:5432/railway

# How many pooled connections this process may hold. Default 10. One long-lived
# server wants a real pool; the old value of 1 was a serverless constraint.
DATABASE_POOL_MAX=

# TLS is skipped on *.internal hosts (private network, and those images often have
# no certificate) and VERIFIED everywhere else. Set this to 1 only if you must
# reach a public database whose certificate chain does not validate — it means
# encrypted but unauthenticated, which is what we moved away from.
DATABASE_SSL_NO_VERIFY=

# Railway sets PORT itself — do not set it there. HOST defaults to 0.0.0.0, which
# is what a container needs; only override it for a local run you want bound to
# localhost. LOG_LEVEL is a pino level: silent, error, warn, info (default), debug.
PORT=
HOST=
LOG_LEVEL=

# ── The admin dashboard at /admin ───────────────────────────────────────────
# This pair IS the password reset: change them here and the login changes — and
# changing the password now also ends every session that was already signed in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=at-least-ten-characters
# Optional display name for that account, shown in the audit log.
ADMIN_NAME=

# REQUIRED. Signs the admin session cookie; nobody can sign in without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# It used to fall back to a value derived from ADMIN_TOKEN, which made one secret
# both authenticate machine callers and sign cookies — leaking it granted access
# AND the ability to forge sessions. They are separate now.
ADMIN_SESSION_SECRET=

# Optional machine credential for curl, cron and `npm run preflight`. It grants
# everything a signed-in admin can do, so it must be at least 32 characters — a
# shorter one is refused rather than quietly accepted.
ADMIN_TOKEN=

# ── Email, via Resend ───────────────────────────────────────────────────────
# Without this, no family is ever emailed their access code — they only see it
# on screen, and losing it becomes your problem to solve by hand.
# The domain in EMAIL_FROM must be verified in Resend (DKIM + SPF + MX) or
# delivery silently fails to everyone except the account owner.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Brainy <brainy@fortbridge.app>
EMAIL_REPLY_TO=

# Emails you on every sign-up, redemption, payment and bank transfer.
OPERATOR_EMAIL=

# ── Card payments, via Paystack ─────────────────────────────────────────────
# Unset ⇒ checkout is switched off and the app says so, rather than showing a
# button that fails.
#
# NOTE: Paystack's webhook is NOT an environment variable. It is a URL you paste
# into the Paystack dashboard (Settings → API Keys & Webhooks). Point it at the API
# service DIRECTLY rather than through the site — the signature is an HMAC over the
# exact bytes, so fewer hops is better, and it keeps working while the front end is
# mid-deploy:
#   https://api-brainy.fortbridge.app/api/webhook       ← use this
#   https://api-brainy.fortbridge.app/api/pay/webhook   (the same function)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=NGN

# Prices in MINOR units — kobo. ₦5,000 is 500000. Defaults shown.
PRICE_ANNUAL_MINOR=500000
PRICE_LIFETIME_MINOR=1500000

# ── Bank transfer ───────────────────────────────────────────────────────────
# How most Nigerian families will actually pay. All three must be set or the
# option is hidden from parents entirely. A parent submits a claim; you confirm
# it against your own statement under Transfers in the dashboard, and only then
# is a licence granted and the code emailed.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
# One line shown under the account details, e.g. "Use your email as the
# narration so we can match it."
BANK_INSTRUCTIONS=

# ── The twenty free places ──────────────────────────────────────────────────
# A coupon code that every sign-up tries automatically, so prd.md §14.3 is
# honoured by whoever gets there first and stops being offered the moment the
# uses run out. Create the code under Coupons → "First run", then paste it here.
SIGNUP_COUPON=

# ── Renewal warnings ────────────────────────────────────────────────────────
# Vercel Cron sends this as a Bearer token; without it /api/cron/expiring
# refuses to run, because a public endpoint that sends email sends spam.
CRON_SECRET=

# ── Odds and ends ───────────────────────────────────────────────────────────
# Origin used in emails and the Paystack return URL. Derived from the request
# when unset, which is right for production and wrong for nothing much.
PUBLIC_BASE_URL=https://brainy.fortbridge.app

# Push a copy of each sign-up, payment, transfer and piece of feedback OUT to
# somewhere you already look — a Slack or Discord incoming webhook, an Apps
# Script, a WhatsApp relay.
#
# This is nothing to do with Paystack. It is outbound only; nobody calls it. And
# it must never point back at this deployment: /api/report forwards to whatever
# is here, so aiming it at ourselves is a loop. With OPERATOR_EMAIL set you do
# not need it at all.
REPORT_WEBHOOK_URL=

# Google Analytics for the marketing site only — never /play/ or /admin, and
# the build fails if a Google script reaches the app. Defaults to the live
# property in scripts/build-site.mjs; set to an empty string to build with
# analytics off.
GA_MEASUREMENT_ID=
