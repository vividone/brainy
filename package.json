{
  "name": "brainy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gamified curriculum practice for primary-school children",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "node scripts/clean.mjs && tsc -b && vite build && node scripts/build-site.mjs",
    "typecheck": "tsc -b --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:api": "node scripts/api-smoke.mjs",
    "smoke:server": "node scripts/server-smoke.mjs",
    "coverage": "node scripts/coverage.mjs",
    "sample": "node scripts/sample.mjs",
    "preflight": "node scripts/preflight.mjs",
    "icons": "node scripts/make-icons.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "fastify": "^5.11.2",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  },
  "engines": {
    "node": ">=20"
  }
}
